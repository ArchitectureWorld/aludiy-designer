{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aludiy.local/schema/section-0.1.0.json",
  "title": "AluDIY SectionDefinition",
  "type": "object",
  "required": ["section_id", "width_mm", "height_mm", "origin_uv_mm", "geometry_hash", "faces", "interfaces"],
  "properties": {
    "section_id": {"type": "string", "minLength": 1},
    "width_mm": {"type": "number", "exclusiveMinimum": 0},
    "height_mm": {"type": "number", "exclusiveMinimum": 0},
    "origin_uv_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "geometry_hash": {"type": "string", "minLength": 1},
    "representations": {"type": "object", "additionalProperties": {"type": "string"}},
    "faces": {"type": "array", "minItems": 4},
    "interfaces": {"type": "array"}
  },
  "additionalProperties": false
}
